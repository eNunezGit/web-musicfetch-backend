# Copia este archivo como .env y rellena los valores reales.
# .env está en .gitignore: nunca lo subas al repositorio.

# --- Desarrollo local ---
NODE_ENV=development
PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017/musicfetchdb

# Genera uno propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Orígenes autorizados, separados por comas. Si se omite, se usan los
# valores por defecto de utils/config.js (Vercel + localhost).
# ALLOWED_ORIGINS=https://web-musicfetch-frontend.vercel.app,http://localhost:3000


# --- Producción (en la VM de Google Cloud) ---
# NODE_ENV=production
# PORT=3000
# MONGO_URL=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/musicfetchdb?retryWrites=true&w=majority
# JWT_SECRET=<32 bytes en hexadecimal, distinto del de desarrollo>
# ALLOWED_ORIGINS=https://web-musicfetch-frontend.vercel.app
